										<DataType>String</DataType>
										<Container/>
									</DataPoint><DataPoint name="PwrBrd_RevDate">
										<Prompt>Power Board Rev Date (YYWW):</Prompt>
										<DataType>String</DataType>
										<Container/>
									</DataPoint>
								</DataPoints>
								<Description>Please enter the following information which was previously recorded. Enter a dash for unused fields such as empty module locations (i.e. enter "-" in LLA 2 and 4 fields if those modules are not present).</Description>
							</DataCollection>
						</Task>
						<Diagnostics/>
						<Comment/>
					</Step><Step id="S23.ID_UVI264_BrdInst_ATP-832-34_76" title="Create Config File" manual="false" duration="PT0H0M" OnFail="0" state="Initial" lastupdated="12:00:00 AM" selected="false" elapsed="PT0H0M0S" runcount="0">
						<Prerequisites/>
						<Qualifiers/>
						<Task>
							<Script Visible="true">
								<Instructions/>
								<Path>"%Procedures%shared\scripts\HLA_config.pl" Raiden %HLA_PN% %HLA_SN% %HLA_RevDate% %HLA_Slot% %LLA1_PN% %LLA1_SN% %LLA1_RevDate% %LLA1_Slot% %LLA2_PN% %LLA2_SN% %LLA2_RevDate% %LLA2_Slot% %LLA3_PN% %LLA3_SN% %LLA3_RevDate% %LLA3_Slot% %LLA4_PN% %LLA4_SN% %LLA4_RevDate% %LLA4_Slot% %PwrBrd_PN% %PwrBrd_SN% %PwrBrd_RevDate%</Path>
							</Script>
						</Task>
						<Diagnostics/>
						<Comment/>
					</Step><Step id="S24.ID_UVI264_BrdInst_ATP-832-34_55" title="Verify Config File" manual="true" duration="PT0H0M" OnFail="0" state="Initial" lastupdated="12:00:00 AM" selected="false" elapsed="PT0H0M0S" runcount="0">
						<Prerequisites/>
						<Qualifiers/>
						<Task>
							<Command Visible="true">
								<Instructions><Instruction>
										<xhtml-subset><big><big>Please ensure the contents of the config file are correct. Make any necessary changes and save the file. Close notepad when finished.</big>
											</big>
										</xhtml-subset>
									</Instruction>
								</Instructions>
								<Path>cmd /C start /W notepad "C:\test\tmp\Board.instprom"</Path>
							</Command>
						</Task>
						<Diagnostics/>
						<Comment/>
					</Step><Step id="S25.ID_UVI264_BrdInst_ATP-832-34_35" title="Execute NVRAM Programming" manual="false" duration="PT0H0M" OnFail="0" state="Initial" lastupdated="12:00:00 AM" selected="false" elapsed="PT0H0M0S" runcount="0">
