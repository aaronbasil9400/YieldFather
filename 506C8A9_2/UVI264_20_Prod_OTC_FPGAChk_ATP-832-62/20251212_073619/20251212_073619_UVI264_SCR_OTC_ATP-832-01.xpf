<?xml-stylesheet href='C:\Program Files (x86)\Teradyne\Test Process Manager\3.20\Process.xsl' type='text/xsl'?>
<Process title=""><Assignment><From/><To/><WorkArea></WorkArea><PlannedStart>12/12/2025 7:32:08 AM</PlannedStart><PlannedFinish>12/12/2025 7:32:08 AM</PlannedFinish><ActualStart>12/12/2025 7:32:22 AM</ActualStart><ActualFinish>12:00:00 AM</ActualFinish><SystemNumber></SystemNumber>
	</Assignment><Order customer="" orderID=""/><Configuration/><Flow OnFail="0" id="F1.ID_UVI264_SCR_OTC_ATP-832-01_3" title="UVI264 OTC" procedure="UVI264_SCR_OTC_ATP-832-01" revision="X1.0.3" basepath="C:\Test\Procedures\" branch="true" state="Initial" lastupdated="12/12/2025 7:36:16 AM" selected="true">
		<Prerequisites></Prerequisites>
		<Qualifiers><Qualifier>
				<Manual>
					<Warning Category="High Voltage Hazard">The electronics utilize voltages considered potentially hazardous for human exposure. Precautions should be taken to avoid injury. Always assume that there is hazardous voltage at a node at any given time. Do not wear jewelry (e.g. rings, watches, bracelets, etc.) in the presence of high voltages as injury (e.g. burns) to personnel, or damage to equipment may occur. Avoid contact with DIB connections.</Warning>
				</Manual>
			</Qualifier><Qualifier>
				<Command Visible="true">
					<Instructions/>
					<Path>"%ATP_PROCEDURES_LOCAL%\shared\scripts\UFII_Common_SetTPMVar.exe" FileAtp ATP-832-01 BrdName UVI264 TstStage OTC</Path>
				</Command>
			</Qualifier><Qualifier>
				<Command Visible="true">
					<Instructions><Instruction>
							<xhtml-subset><big><big><big>Please select the instrument dash number and test environment.</big>
									</big>
								</big>
							</xhtml-subset>
						</Instruction>
					</Instructions>
					<Path>"%ATP_PROCEDURES_LOCAL%\shared\scripts\UFII_Common_SetTPMVar.exe" -s Dash_Number,BrdDsh,20,21 Environment,TstEnv,Production,Recertification,Engineering</Path>
				</Command>
			</Qualifier><Qualifier>
				<Command Visible="true">
					<Instructions>
						<Instruction>
							<text/>
						</Instruction>
					</Instructions>
					<Path>cmd /c if "%PEV_TstEnv%"=="Production" ("%ATP_PROCEDURES_LOCAL%\shared\scripts\UFII_Common_SetTPMVar.exe" TstEnv Prod) else (if "%PEV_TstEnv%"=="Recertification" ("%ATP_PROCEDURES_LOCAL%\shared\scripts\UFII_Common_SetTPMVar.exe" TstEnv Recert) else ("%ATP_PROCEDURES_LOCAL%\shared\scripts\UFII_Common_SetTPMVar.exe" TstEnv Eng))</Path>
				</Command>
			</Qualifier><Qualifier>
				<Command Visible="true">
					<Instructions/>
					<Path>"%ATP_PROCEDURES_LOCAL%\shared\scripts\UFII_Common_SetTPMVar.exe" FileBase %PEV_BrdName%_%PEV_BrdDsh%_%PEV_TstEnv%_%PEV_TstStage%</Path>
				</Command>
			</Qualifier><Qualifier>
				<Command Visible="true">
					<Instructions/>
					<Path>cmd /c copy /Y NUL "%igxlroot%\tester\MUIInhouseMode.txt"</Path>
				</Command>
			</Qualifier><Qualifier>
				<Command Visible="true">
					<Instructions/>
					<Path>cmd /c del "%IGXLROOT%"\tester\NoColdPlateInstalled.txt</Path>
				</Command>
			</Qualifier>
		</Qualifiers>
		<Flow id="F2.ID_UVI264_SCR_OTC_ATP-832-01_0" title="Initial Setup" OnFail="0" state="Pass" lastupdated="12/12/2025 7:33:56 AM" selected="false" procedure="UVI264_SCR_OTC_ATP-832-01" branch="false">
