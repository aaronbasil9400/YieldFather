			<Step id="S77.ID_UVI264_SCR_OTC_ATP-832-01_5" title="Enter DMM Information" manual="true" duration="PT0H0M" OnFail="0" state="Initial" lastupdated="12:00:00 AM" selected="true" elapsed="PT0H0M0S" runcount="0">
				<Prerequisites/>
				<Qualifiers/>
				<Task>
					<Script Visible="true">
						<Instructions><Instruction>
								<xhtml-subset><big><big>
Enter 3458A DMM Serial Number, Cal Due date, Ambient Temperature (C) and Relative Humidity (%).
</big>
									</big>
								</xhtml-subset>
							</Instruction>
						</Instructions>
						<Path>C:\Test\Procedures\shared\scripts\Tesla_NIST_Instr_check.pl</Path>
					</Script>
				</Task>
				<Diagnostics/>
				<Comment/>
			</Step><Flow id="F78.ID_UVI264_SCR_OTC_ATP-832-01_77" title="Connect Equipment" OnFail="0" state="Initial" lastupdated="12:00:00 AM" selected="true" procedure="UVI264_Checkers_ATP-832-49" branch="false">
				<Prerequisites/>
				<Qualifiers/>
				<Step id="S79.ID_UVI264_SCR_OTC_ATP-832-01_20" title="Connect Equipment" manual="true" duration="PT0H0M" OnFail="0" state="Initial" lastupdated="12:00:00 AM" selected="true" elapsed="PT0H0M0S" runcount="0">
					<Prerequisites/>
					<Qualifiers/>
					<Task>
						<Manual>
							<Instruction>
								<xhtml-subset><big><big>Please connect the DC calibration cable to the Keysight 3458A-002 DMM. Connect the P2 connector to the input port. Connect the P3 connector to the sense port. Ensure the guard button is in the low position and the terminal button is in the front position. The guard cables are left disconnected from the DMM and each other. Also, ensure the GPIB address is set to 22.</big>
									</big>
								</xhtml-subset>
							</Instruction>
							<Figure src=".\UVI264_SCR_OTC_ATP-832-01\images\DMM_connections.jpg">DMM Connections</Figure><Instruction>
								<xhtml-subset><big><big>If using a system, turn the DC calbus side panel keyswitch so that it is perpendicular to the connector. If using a TB6, ensure there is a jumper installed on the HVPNL connection on the support backplane.</big>
									</big>
								</xhtml-subset>
							</Instruction><Figure src=".\UVI264_SCR_OTC_ATP-832-01\images\TH_Side_Panel.jpg">DC Calbus Keyswitch</Figure>
						</Manual>
					</Task>
					<Diagnostics/>
					<Comment/>
				</Step>
			</Flow><Flow id="F80.ID_UVI264_SCR_OTC_ATP-832-01_29" title="UVI264 Calibration" procedure="UVI264_Calibration_ATP-832-51" revision="V1.0.0" basepath="C:\Test\Procedures\" branch="true" OnFail="0" state="Initial" lastupdated="12:00:00 AM" selected="true">
				<Prerequisites/>
				<Qualifiers><Qualifier>
						<Command Visible="true">
							<Instructions/>
							<Path>cmd /c del "%IGXLROOT%"\tester\IgnoreCal.txt</Path>
						</Command>
					</Qualifier><Qualifier>
						<Command Visible="true">
							<Instructions/>
							<Path>"%Procedures%shared\scripts\UFII_Common_SetTPMVar.exe" FileAtp ATP-832-51 BrdName UVI264</Path>
						</Command>
					</Qualifier><Qualifier>
						<Command Visible="true">
							<Instructions/>
							<Path>"%Procedures%shared\scripts\UFII_Common_SetTPMVar.exe" SettingsFile C:\Test\Procedures\UVI264_Calibration_ATP-832-51\documents\UVI264_ExtCal.msf TstName ExtCal</Path>
						</Command>
					</Qualifier>
				</Qualifiers><Flow id="F81.ID_UVI264_Calibration_ATP-832-51_9" title="Stand Alone Support" OnFail="0" state="Initial" lastupdated="12:00:00 AM" selected="true" procedure="UVI264_Calibration_ATP-832-51" branch="false">
					<Prerequisites/>
					<Qualifiers><Qualifier>
							<Script Visible="true">
								<Instructions/>
								<Path>"%Procedures%shared\scripts\UFII_Common_ChkMode.pl" "%Session%" -chk -ATP-832-51</Path>
							</Script>
						</Qualifier><Qualifier>
							<Manual>
								<Warning Category="High Voltage Hazard">The electronics utilize voltages considered potentially hazardous for human exposure. Precautions should be taken to avoid injury. Always assume that there is hazardous voltage at a node at any given time. Do not wear jewelry (e.g. rings, watches, bracelets, etc.) in the presence of high voltages as injury (e.g. burns) to personnel, or damage to equipment may occur. Avoid contact with DIB connections.</Warning>
							</Manual>
						</Qualifier><Qualifier>
							<Command Visible="true">
								<Instructions/>
								<Path>"%Procedures%shared\scripts\UFII_Common_SetTPMVar.exe" FileAtp ATP-832-51 BrdName UVI264</Path>
							</Command>
						</Qualifier><Qualifier>
							<Command Visible="true">
								<Instructions/>
								<Path>"%Procedures%shared\scripts\UFII_Common_SetTPMVar.exe" -s Environment,TstEnv,Production,Engineering Test_Stage,TstStage,MTF,OTC Board_Dash_Number,BrdDsh,20</Path>
							</Command>
						</Qualifier><Qualifier>
							<Command Visible="true">
								<Instructions/>
								<Path>cmd /c if "%PEV_TstEnv%"=="Production" ("%ATP_PROCEDURES_LOCAL%\shared\scripts\UFII_Common_SetTPMVar.exe" TstEnv Prod) else (if "%PEV_TstEnv%"=="Recertification" ("%ATP_PROCEDURES_LOCAL%\shared\scripts\UFII_Common_SetTPMVar.exe" TstEnv Recert) else ("%ATP_PROCEDURES_LOCAL%\shared\scripts\UFII_Common_SetTPMVar.exe" TstEnv Eng))</Path>
							</Command>
						</Qualifier><Qualifier>
							<Command Visible="true">
								<Instructions/>
								<Path>"%Procedures%shared\scripts\UFII_Common_SetTPMVar.exe" FileBase %PEV_BrdName%_%PEV_BrdDsh%_%PEV_TstEnv%_%PEV_TstStage%</Path>
							</Command>
						</Qualifier><Qualifier>
							<Command Visible="true">
								<Instructions/>
								<Path>cmd /c if "%PEV_TstStage%"=="OTC" ("%Procedures%shared\scripts\UFII_Common_SetTPMVar.exe" SettingsFile C:\Test\Procedures\UVI264_Calibration_ATP-832-51\documents\UVI264_HLA_Cal.msf TstName HLACal) else ("%Procedures%shared\scripts\UFII_Common_SetTPMVar.exe" SettingsFile C:\Test\Procedures\UVI264_Calibration_ATP-832-51\documents\UVI264_MTF_Cal.msf TstName MTFCal)</Path>
							</Command>
						</Qualifier>
					</Qualifiers>
					<Step id="S82.ID_UVI264_Calibration_ATP-832-51_5" title="Archive Datalogs" manual="true" duration="PT0H0M" OnFail="0" state="Initial" lastupdated="12:00:00 AM" selected="true" elapsed="PT0H0M0S" runcount="0">
