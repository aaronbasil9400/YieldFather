										<Prompt>LLA 2 Part Number:</Prompt>
										<DataType>String</DataType>
										<Container/>
									</DataPoint><DataPoint name="LLA2_SN">
										<Prompt>LLA 2 Serial Number:</Prompt>
										<DataType>String</DataType>
										<Container/>
									</DataPoint><DataPoint name="LLA2_RevDate">
										<Prompt>LLA 2 Rev Date (YYWW):</Prompt>
										<DataType>String</DataType>
										<Container/>
									</DataPoint><DataPoint name="LLA2_Slot">
										<Prompt>LLA 2 Slot and Module (e.g. 19.2):</Prompt>
										<DataType>String</DataType>
										<Container/>
									</DataPoint><DataPoint name="LLA3_PN">
