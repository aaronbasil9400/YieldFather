									<Instructions/>
									<Path>"%Procedures%shared\scripts\UFII_Common_Backup.pl" -chk -inc "C:\test\tmp\IncFile.txt" -p %PEV_FileName% -s -spc</Path>
								</Script>
							</Diagnostic><Diagnostic>
								<Command Visible="true">
									<Instructions/>
									<Path>"%Procedures%shared\scripts\UFII_Common_SetTPMVar.exe" -c FileName TstName FileTst</Path>
								</Command>
							</Diagnostic><Diagnostic>
