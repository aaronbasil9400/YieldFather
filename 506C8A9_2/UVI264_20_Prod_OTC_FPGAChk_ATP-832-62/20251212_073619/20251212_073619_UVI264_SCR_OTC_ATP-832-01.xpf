											<text/>
										</Instruction>
									</Instructions>
									<Path>"%Procedures%UVI264_ExtDCPV_ATP-832-30\scripts\UFII_UVI264_LogDIB.pl"</Path>
								</Script>
							</Qualifier>
						</Qualifiers>
						<Task>
							<Command Visible="true">
								<Instructions><Instruction>
										<xhtml-subset><big><big>Please follow the steps within Maintenance to setup any required external equipment.</big>
											</big>
										</xhtml-subset>
									</Instruction>
								</Instructions>
								<Path>%igxlroot%\bin\Maintenance.exe -s %PEV_SettingsFile% -r -q</Path>
							</Command>
						</Task>
						<Diagnostics><Diagnostic>
								<Command Visible="true">
