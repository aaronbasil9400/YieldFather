			<Flow id="F31.ID_UVI264_SCR_OTC_ATP-832-01_901" title="UVI264 FPGA Program" procedure="UVI264_FPGAProg_ATP-832-62" revision="V1.0.0" basepath="C:\Test\Procedures\" branch="true" OnFail="0" state="Initial" lastupdated="12/12/2025 7:36:16 AM" selected="true">
				<Prerequisites/>
				<Qualifiers><Qualifier>
						<Command Visible="true">
							<Instructions/>
							<Path>"%Procedures%shared\scripts\UFII_Common_SetTPMVar.exe" FileAtp ATP-832-62 BrdName UVI264</Path>
						</Command>
					</Qualifier>
				</Qualifiers><Flow id="F32.ID_UVI264_FPGAProg_ATP-832-62_9" title="Stand Alone Support" OnFail="0" state="NotApplicable" lastupdated="12/12/2025 7:34:12 AM" selected="true" procedure="UVI264_FPGAProg_ATP-832-62" branch="false">
					<Prerequisites/>
					<Qualifiers><Qualifier>
							<Script Visible="true">
								<Instructions/>
								<Path>"%Procedures%shared\scripts\UFII_Common_ChkMode.pl" "%Session%" -chk -ATP-832-62</Path>
							</Script>
						</Qualifier><Qualifier>
							<Manual>
								<Warning Category="High Voltage Hazard">The electronics utilize voltages considered potentially hazardous for human exposure. Precautions should be taken to avoid injury. Always assume that there is hazardous voltage at a node at any given time. Do not wear jewelry (e.g. rings, watches, bracelets, etc.) in the presence of high voltages as injury (e.g. burns) to personnel, or damage to equipment may occur. Avoid contact with DIB connections.</Warning>
							</Manual>
						</Qualifier><Qualifier>
							<Command Visible="true">
								<Instructions/>
								<Path>"%Procedures%shared\scripts\UFII_Common_SetTPMVar.exe" FileAtp ATP-832-62 BrdName UVI264</Path>
							</Command>
						</Qualifier><Qualifier>
							<Command Visible="true">
								<Instructions/>
								<Path>"%Procedures%shared\scripts\UFII_Common_SetTPMVar.exe" -s Environment,TstEnv,Production,Engineering Test_Stage,TstStage,MTF,OTC Board_Dash_Number,BrdDsh,20,30,31</Path>
							</Command>
						</Qualifier><Qualifier>
							<Command Visible="true">
								<Instructions/>
								<Path>cmd /c if "%PEV_TstEnv%"=="Production" ("%ATP_PROCEDURES_LOCAL%\shared\scripts\UFII_Common_SetTPMVar.exe" TstEnv Prod) else (if "%PEV_TstEnv%"=="Recertification" ("%ATP_PROCEDURES_LOCAL%\shared\scripts\UFII_Common_SetTPMVar.exe" TstEnv Recert) else ("%ATP_PROCEDURES_LOCAL%\shared\scripts\UFII_Common_SetTPMVar.exe" TstEnv Eng))</Path>
							</Command>
						</Qualifier><Qualifier>
							<Command Visible="true">
								<Instructions/>
								<Path>"%Procedures%shared\scripts\UFII_Common_SetTPMVar.exe" FileBase %PEV_BrdName%_%PEV_BrdDsh%_%PEV_TstEnv%_%PEV_TstStage%</Path>
							</Command>
						</Qualifier>
					</Qualifiers>
					<Step id="S33.ID_UVI264_FPGAProg_ATP-832-62_32" title="Archive Datalogs" manual="false" duration="PT0H0M" OnFail="0" state="NotApplicable" lastupdated="12:00:00 AM" selected="true" elapsed="PT0H0M0S" runcount="0">
