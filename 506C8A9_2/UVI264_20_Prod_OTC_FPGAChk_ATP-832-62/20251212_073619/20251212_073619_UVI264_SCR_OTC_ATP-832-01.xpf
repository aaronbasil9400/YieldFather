							<Command Visible="true">
								<Instructions/>
								<Path>%igxlroot%\bin\Uflex2EEPROMTool.exe -m inst -f C:\test\tmp\Board.instprom -w</Path>
							</Command>
						</Task>
						<Diagnostics/>
						<Comment/>
					</Step>
				</Flow>
				<Flow id="F26.ID_UVI264_BrdInst_ATP-832-34_7" title="NVRAM Verification" OnFail="0" state="Pass" lastupdated="12/12/2025 7:34:10 AM" selected="false" procedure="UVI264_BrdInst_ATP-832-34" branch="false">
					<Prerequisites/>
					<Qualifiers><Qualifier>
							<Command Visible="false">
								<Instructions/>
								<Path>perl -e "if (index("%PEV_ProcExMode83234%", 'NvramVerify') != -1) {exit 0}else{exit 120}</Path>
							</Command>
						</Qualifier>
					</Qualifiers>
					<Step id="S27.ID_UVI264_BrdInst_ATP-832-34_89" title="Power and TRDS Verification" manual="true" duration="PT0H0M" OnFail="0" state="Pass" lastupdated="12/12/2025 7:34:06 AM" selected="false" elapsed="PT0H0M0S" runcount="1">
						<Prerequisites/>
						<Qualifiers/>
						<Task>
							<Manual><Instruction>
									<xhtml-subset><ul>
											<li><big><big><big>Ensure system test power (48V) is <b>ON</b>
														</big>
													</big>
												</big>
											</li>
											<li><big><big><big>Ensure TRDS is mapped and says ready.</big>
													</big>
												</big>
											</li>
											<li><big><big><big>Select continue to proceed.</big>
													</big>
												</big>
											</li>
										</ul>
									</xhtml-subset>
								</Instruction>
							</Manual>
						</Task>
						<Diagnostics/>
						<Comment/>
					</Step><Step id="S28.ID_UVI264_BrdInst_ATP-832-34_3" title="NVRAM Data Verification" manual="true" duration="PT0H0M" OnFail="0" state="Pass" lastupdated="12/12/2025 7:34:09 AM" selected="false" elapsed="PT0H0M0S" runcount="1">
						<Prerequisites>
							<Prerequisite step="S27.ID_UVI264_BrdInst_ATP-832-34_89"/>
						</Prerequisites>
						<Qualifiers/>
						<Task>
							<Command Visible="false">
								<Instructions><Instruction>
										<xhtml-subset><ul>
												<li><big><big><big>This step will launch EEPROM Tool which is used to verify and update the NVRAM.</big>
														</big>
													</big>
												</li>
												<li><big><big><big>Select the <b>boards</b> button.
															</big>
														</big>
													</big>
												</li>
												<li><big><big><big>Select the slot from the pull down menu and choose the slot where the UVI264 is installed.</big>
														</big>
													</big>
												</li>
												<li><big><big><big>Verify that the part numbers, serial numbers, rev, and rev dates for each board is correct</big>
														</big>
													</big>
												</li>
												<li><big><big><big>If any changes have been made, select <b>write to hardware</b>
															</big>
														</big>
													</big>
												</li>
												<li><big><big><big>Wait for TRDS to finishing remapping. Verify that TRDS does not show any initialization errors. If so, select remap.</big>
														</big>
													</big>
												</li>
												<li><big><big><big>Repeat for all UVI264 boards installed in the system.</big>
														</big>
													</big>
												</li>
												<li><big><big><big>Close EEPROM tool when finished to proceed.</big>
														</big>
													</big>
												</li>
											</ul>
										</xhtml-subset>
									</Instruction>
								</Instructions>
								<Path>"%IGXLROOT%\bin\Uflex2EEPROMTool.exe"</Path>
							</Command>
						</Task>
						<Diagnostics/>
						<Comment/>
					</Step><Step id="S29.ID_UVI264_BrdInst_ATP-832-34_93" title="Board Revision Verification" manual="false" duration="PT0H0M" OnFail="0" state="Pass" lastupdated="12/12/2025 7:34:10 AM" selected="false" elapsed="PT0H0M0S" runcount="1">
						<Prerequisites>
							<Prerequisite step="S27.ID_UVI264_BrdInst_ATP-832-34_89"/>
							<Prerequisite step="S28.ID_UVI264_BrdInst_ATP-832-34_3"/>
						</Prerequisites>
						<Qualifiers/>
						<Task>
							<Script Visible="true">
								<Instructions/>
								<Path>"%Procedures%shared\scripts\UFII_Common_ECNMasterList.pl" -infile "%IGXLROOT%\tester\PhysicalConfig.txt"</Path>
							</Script>
						</Task>
						<Diagnostics><Diagnostic>
								<Manual>
									<Instruction>
										<xhtml-subset><big><big><big><b>Board revision verification has failed.
<br/><br/>Please review the <i><b style="color:BLUE">"C:\Test\tmp\ECNUpdate.log"</b>
															</i> file for the ECN or FPGA firmware updates that may be needed.
														</b><br/><br/>
													</big>
												</big>
											</big>
										</xhtml-subset>
									</Instruction>
									<Link src="c:/Test/tmp/ECNUpdate.log">c:\Test\tmp\ECNUpdate.log</Link>
								</Manual>
							</Diagnostic>
						</Diagnostics>
						<Comment/>
					</Step>
				</Flow>
			</Flow>
		</Flow><Flow id="F30.ID_UVI264_SCR_OTC_ATP-832-01_67" title="FPGA Check" OnFail="0" state="Initial" lastupdated="12/12/2025 7:36:16 AM" selected="true" procedure="UVI264_BrdInst_ATP-832-34" branch="false">
