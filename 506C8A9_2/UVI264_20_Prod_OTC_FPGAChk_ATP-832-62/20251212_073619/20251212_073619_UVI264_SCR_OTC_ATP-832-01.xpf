						<Script Visible="true">
							<Instructions/>
							<Path>"%Procedures%shared\scripts\UFII_Common_set_msf.pl" -chkr "%PEV_SettingsFile%" -lp %PEV_ChkLoop%</Path>
						</Script>
					</Qualifier><Qualifier>
						<Manual><Instruction>
								<xhtml-subset><big><big>Please install the Raiden Pass Thru PV DIB with Rider Boards: 660-077-00.</big>
									</big>
								</xhtml-subset>
							</Instruction>
						</Manual>
					</Qualifier>
				</Qualifiers><Flow id="F189.ID_UVI264_ExtDCPV_ATP-832-30_7" title="Stand Alone Support" OnFail="0" state="Initial" lastupdated="12:00:00 AM" selected="true" procedure="UVI264_ExtDCPV_ATP-832-30" branch="false">
					<Prerequisites/>
					<Qualifiers><Qualifier>
							<Script Visible="true">
								<Instructions/>
								<Path>"%Procedures%shared\scripts\UFII_Common_ChkMode.pl" "%Session%" -chk -ATP-832-30</Path>
							</Script>
						</Qualifier><Qualifier>
							<Manual>
								<Warning Category="High Voltage Hazard">The electronics utilize voltages considered potentially hazardous for human exposure. Precautions should be taken to avoid injury. Always assume that there is hazardous voltage at a node at any given time. Do not wear jewelry (e.g. rings, watches, bracelets, etc.) in the presence of high voltages as injury (e.g. burns) to personnel, or damage to equipment may occur. Avoid contact with DIB connections.</Warning>
							</Manual>
						</Qualifier><Qualifier>
							<Command Visible="true">
								<Instructions/>
								<Path>"%Procedures%shared\scripts\UFII_Common_SetTPMVar.exe" FileAtp ATP-832-30 BrdName UVI264</Path>
							</Command>
						</Qualifier><Qualifier>
							<Command Visible="true">
								<Instructions/>
								<Path>"%Procedures%shared\scripts\UFII_Common_SetTPMVar.exe" -s Environment,TstEnv,Production,Engineering Test_Stage,TstStage,MTF,OTC Board_Dash_Number,BrdDsh,20</Path>
							</Command>
						</Qualifier><Qualifier>
							<Command Visible="true">
								<Instructions/>
								<Path>cmd /c if "%PEV_TstEnv%"=="Production" ("%ATP_PROCEDURES_LOCAL%\shared\scripts\UFII_Common_SetTPMVar.exe" TstEnv Prod) else (if "%PEV_TstEnv%"=="Recertification" ("%ATP_PROCEDURES_LOCAL%\shared\scripts\UFII_Common_SetTPMVar.exe" TstEnv Recert) else ("%ATP_PROCEDURES_LOCAL%\shared\scripts\UFII_Common_SetTPMVar.exe" TstEnv Eng))</Path>
							</Command>
						</Qualifier><Qualifier>
							<Command Visible="true">
