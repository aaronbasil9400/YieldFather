										<DataType>String</DataType>
										<Container/>
									</DataPoint><DataPoint name="LLA3_SN">
										<Prompt>LLA 3 Serial Number:</Prompt>
										<DataType>String</DataType>
										<Container/>
									</DataPoint><DataPoint name="LLA3_RevDate">
										<Prompt>LLA 3 Rev Date (YYWW):</Prompt>
										<DataType>String</DataType>
										<Container/>
									</DataPoint><DataPoint name="LLA3_Slot">
										<Prompt>LLA 3 Slot and Module (e.g. 19.3):</Prompt>
										<DataType>String</DataType>
										<Container/>
									</DataPoint><DataPoint name="LLA4_PN">
										<Prompt>LLA 4 Part Number:</Prompt>
										<DataType>String</DataType>
										<Container/>
									</DataPoint><DataPoint name="LLA4_SN">
										<Prompt>LLA 4 Serial Number:</Prompt>
										<DataType>String</DataType>
										<Container/>
									</DataPoint><DataPoint name="LLA4_RevDate">
										<Prompt>LLA 4 Rev Date (YYWW):</Prompt>
										<DataType>String</DataType>
										<Container/>
									</DataPoint><DataPoint name="LLA4_Slot">
										<Prompt>LLA 4 Slot and Module (e.g. 19.4):</Prompt>
										<DataType>String</DataType>
										<Container/>
									</DataPoint><DataPoint name="PwrBrd_PN">
										<Prompt>Power Board Part Number:</Prompt>
										<DataType>String</DataType>
