							<Command Visible="true">
								<Instructions/>
								<Path>"%ATP_PROCEDURES_LOCAL%\shared\scripts\UFII_Common_SetTPMVar.exe" FileName %PEV_FileBase%%PEV_FileTst%</Path>
							</Command>
						</Qualifier>
					</Qualifiers>
					<Step id="S180.ID_UVI264_ExtDCPV_ATP-832-30_4" title="Setup PV Equipment" manual="true" duration="PT0H0M" OnFail="0" state="Initial" lastupdated="12:00:00 AM" selected="true" elapsed="PT0H0M0S" runcount="0">
						<Prerequisites/>
						<Qualifiers/>
						<Task>
							<Manual>
								<Instruction>
									<xhtml-subset><big><big>Please note that PV requires a passing calibration within the last 48 hours. If calibration was not completed within this time requirement, please re-run calibration.</big>
										</big>
									</xhtml-subset>
								</Instruction><Instruction>
									<xhtml-subset><big><big>Please connect the PV DIB equipment as described in the tables linked below and the DMM connection images. Note that the 676-388-00 Interlock Dongle on the Rear Panel of the B2962A SMU is required.</big>
										</big>
									</xhtml-subset>
								</Instruction><Link src="./UVI264_ExtDCPV_ATP-832-30/images/Raiden_Equipment_Connections.jpg">Passthrough PV Equipment Connections</Link><Link src="./UVI264_ExtDCPV_ATP-832-30/images/Raiden_HP_DIB_Connections.jpg">HP PV Equipment Connections</Link><Figure src=".\UVI264_ExtDCPV_ATP-832-30\images\Raiden_HP_PV_GPIB_Addresses.jpg">HP DIB GPIB Address</Figure><Figure src=".\UVI264_ExtDCPV_ATP-832-30\images\Raiden_PT_PV_GPIB_Addresses.jpg">PT DIB GPIB Address</Figure><Figure src=".\UVI264_ExtDCPV_ATP-832-30\images\DMM_connections.jpg">PT PV DMM Connections</Figure><Figure src=".\UVI264_ExtDCPV_ATP-832-30\images\HP_PV_DMM_Connection.jpg">HP PV DMM Connections</Figure><Instruction>
									<xhtml-subset><big><big>Ensure the 3458A-002 DMMs are powered on and warmed-up. Also, run autocal on the 3458A-002 DMMs and ensure the GPIB cables are connected to the tester computer.</big>
										</big>
									</xhtml-subset>
								</Instruction>
								<Instruction>
									<xhtml-subset><big><big>After completing the PV power connections, power on the PV DIB rider power supplies on the PV rack.</big>
										</big>
									</xhtml-subset>
								</Instruction>
							</Manual>
						</Task>
						<Diagnostics/>
						<Comment/>
					</Step><Step id="S181.ID_UVI264_ExtDCPV_ATP-832-30_00" title="PTL Cable Mapping" manual="true" duration="PT0H0M" OnFail="0" state="Initial" lastupdated="12:00:00 AM" selected="true" elapsed="PT0H0M0S" runcount="0">
						<Prerequisites/>
						<Qualifiers><Qualifier>
								<Command Visible="true">
									<Instructions/>
									<Path>cmd /c copy /Y C:\Test\Procedures\UVI264_ExtDCPV_ATP-832-30\documents\DIBCableMapping.txt "%IGXLROOT%\tester\DIBCableMapping.txt"</Path>
								</Command>
							</Qualifier>
						</Qualifiers>
						<Task>
							<Command Visible="true">
								<Instructions><Instruction>
										<xhtml-subset><big><big>Please update the DIB cable mapping file instrument slot and DIB slot based on the Raiden instrument(s) to be PV tested. Once the instrument slot(s) and DIB slot(s) have been updated, save the text file and exit notepad. See the figure below as a reference.</big>
											</big>
										</xhtml-subset>
									</Instruction>
									<Figure src=".\UVI264_ExtDCPV_ATP-832-30\images\DIB_Cable_Mapping_File.jpg">DIB Cable Mapping File</Figure>
								</Instructions>
								<Path>cmd /C start /W notepad "%IGXLROOT%\tester\DIBCableMapping.txt"</Path>
							</Command>
						</Task>
						<Diagnostics/>
						<Comment/>
					</Step><Step id="S182.ID_UVI264_ExtDCPV_ATP-832-30_71" title="Execute PV" manual="false" duration="PT0H0M" OnFail="0" state="Initial" lastupdated="12:00:00 AM" selected="true" elapsed="PT0H0M0S" runcount="0">
						<Prerequisites/>
