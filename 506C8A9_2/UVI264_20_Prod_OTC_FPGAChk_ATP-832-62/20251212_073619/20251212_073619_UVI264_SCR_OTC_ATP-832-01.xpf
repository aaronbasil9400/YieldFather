				</Task>
				<Diagnostics/>
				<Comment/>
			</Step>
		</Flow><Flow id="F4.ID_UVI264_SCR_OTC_ATP-832-01_32" title="Board Install" OnFail="0" state="Initial" lastupdated="12/12/2025 7:34:10 AM" selected="true" procedure="UVI264_SCR_OTC_ATP-832-01" branch="false">
			<Prerequisites/>
			<Qualifiers/>
			<Flow id="F5.ID_UVI264_SCR_OTC_ATP-832-01_90" title="UVI264 Board Install" procedure="UVI264_BrdInst_ATP-832-34" revision="X1.0.0" basepath="C:\Test\Procedures\" branch="true" OnFail="0" state="Initial" lastupdated="12/12/2025 7:34:10 AM" selected="true">
				<Prerequisites/>
				<Qualifiers><Qualifier>
						<Command Visible="true">
							<Instructions/>
							<Path>"%Procedures%shared\scripts\UFII_Common_SetTPMVar.exe" ProcExMode83234 HlaInstall_SmcProgram_NvramProgram_NvramVerify</Path>
						</Command>
					</Qualifier><Qualifier>
						<Command Visible="true">
							<Instructions/>
							<Path>"%Procedures%shared\scripts\UFII_Common_SetTPMVar.exe" ProcFolder UVI264_BrdInst_ATP-832-34</Path>
						</Command>
					</Qualifier>
				</Qualifiers><Flow id="F6.ID_UVI264_BrdInst_ATP-832-34_74" title="Initial Setup" OnFail="0" state="Pass" lastupdated="12/12/2025 7:33:59 AM" selected="false" procedure="UVI264_BrdInst_ATP-832-34" branch="false">
					<Prerequisites/>
					<Qualifiers/>
					<Step id="S7.ID_UVI264_BrdInst_ATP-832-34_28" title="System Setup" manual="true" duration="PT0H0M" OnFail="0" state="Pass" lastupdated="12/12/2025 7:33:59 AM" selected="false" elapsed="PT0H0M0S" runcount="1">
						<Prerequisites/>
						<Qualifiers/>
						<Task>
							<Manual>
								<Instruction>
									<xhtml-subset><big><big><big><b><i>Procedure Reminder:</i>
													</b>
												</big>
											</big>
										</big>
										<ul>
											<li><big><big><big><b>Ensure tester power (48V) is </b><b style="color:RED">OFF</b>
														</big>
													</big>
												</big>
											</li>
											<li><big><big><big>Verify the CDU pump is on and the temperature setpoint is 22 deg C</big>
													</big>
												</big>
											</li>
											<li><big><big><big>Ensure the latest approved/released version of IG-XL is installed on the tester PC</big>
													</big>
												</big>
											</li>
											<li><big><big><big>Follow the board install instructions outlined in the board install section of this procedure</big>
													</big>
												</big>
											</li>
										</ul>
										<big><big><big>Select <b>CONTINUE</b> to proceed
												</big>
											</big>
										</big>
									</xhtml-subset>
								</Instruction>
							</Manual>
						</Task>
						<Diagnostics/>
						<Comment/>
					</Step>
				</Flow><Flow id="F8.ID_UVI264_BrdInst_ATP-832-34_2" title="Stand Alone Support" OnFail="0" state="NotApplicable" lastupdated="12/12/2025 7:34:01 AM" selected="true" procedure="UVI264_BrdInst_ATP-832-34" branch="false">
					<Prerequisites/>
					<Qualifiers><Qualifier>
							<Script Visible="true">
								<Instructions/>
								<Path>"%Procedures%shared\scripts\UFII_Common_ChkMode.pl" "%Session%" -chk -ATP-832-34</Path>
							</Script>
						</Qualifier><Qualifier>
							<Manual>
								<Warning Category="High Voltage Hazard">The electronics utilize voltages considered potentially hazardous for human exposure. Precautions should be taken to avoid injury. Always assume that there is hazardous voltage at a node at any given time. Do not wear jewelry (e.g. rings, watches, bracelets, etc.) in the presence of high voltages as injury (e.g. burns) to personnel, or damage to equipment may occur. Avoid contact with DIB connections.</Warning>
							</Manual>
						</Qualifier><Qualifier>
							<Command Visible="true">
								<Instructions/>
								<Path>"%Procedures%shared\scripts\UFII_Common_SetTPMVar.exe" BrdName UVI264 FileAtp ATP-832-34</Path>
							</Command>
						</Qualifier><Qualifier>
							<Command Visible="true">
								<Instructions/>
								<Path>"%Procedures%shared\scripts\UFII_Common_SetTPMVar.exe" -s Environment,TstEnv,Production Test_Stage,TstStage,MTF,OTC Board_Dash_Number,BrdDsh,10</Path>
							</Command>
						</Qualifier><Qualifier>
							<Command Visible="true">
								<Instructions/>
								<Path>cmd /c if "%PEV_TstEnv%"=="Production" ("%ATP_PROCEDURES_LOCAL%\shared\scripts\UFII_Common_SetTPMVar.exe" TstEnv Prod) else (if "%PEV_TstEnv%"=="Recertification" ("%ATP_PROCEDURES_LOCAL%\shared\scripts\UFII_Common_SetTPMVar.exe" TstEnv Recert) else ("%ATP_PROCEDURES_LOCAL%\shared\scripts\UFII_Common_SetTPMVar.exe" TstEnv Eng))</Path>
							</Command>
						</Qualifier><Qualifier>
							<Command Visible="true">
								<Instructions/>
								<Path>"%Procedures%shared\scripts\UFII_Common_SetTPMVar.exe" FileBase %PEV_BrdName%_%PEV_BrdDsh%_%PEV_TstEnv%_%PEV_TstStage%</Path>
							</Command>
						</Qualifier><Qualifier>
							<Command Visible="true">
								<Instructions/>
								<Path>"%Procedures%shared\scripts\UFII_Common_SetTPMVar.exe" ProcExMode83234 SmcProgram_SmcVerify_Cleanup_Remove_ModuleInstall_NvramProgram_NvramVerify_HlaInstall</Path>
							</Command>
						</Qualifier>
					</Qualifiers>
					<Step id="S9.ID_UVI264_BrdInst_ATP-832-34_53" title="Archive Datalogs" manual="false" duration="PT0H0M" OnFail="0" state="NotApplicable" lastupdated="12:00:00 AM" selected="true" elapsed="PT0H0M0S" runcount="0">
						<Prerequisites/>
						<Qualifiers/>
						<Task>
							<Script Visible="true">
								<Instructions>
									<Instruction>
										<text/>
									</Instruction>
								</Instructions>
								<Path>"%ATP_PROCEDURES_LOCAL%\shared\scripts\UFII_Common_ATP_Setup.pl"</Path>
							</Script>
						</Task>
						<Diagnostics/>
						<Comment/>
					</Step>
				</Flow><Flow id="F10.ID_UVI264_BrdInst_ATP-832-34_9" title="LLA Inspection and Installation" OnFail="0" state="NotApplicable" lastupdated="12/12/2025 7:34:02 AM" selected="true" procedure="UVI264_BrdInst_ATP-832-34" branch="false">
					<Prerequisites/>
					<Qualifiers><Qualifier>
							<Command Visible="true">
								<Instructions/>
								<Path>perl -e "if (index("%PEV_ProcExMode83234%", 'ModuleInstall') != -1) {exit 0}else{exit 120}</Path>
							</Command>
						</Qualifier><Qualifier>
							<Manual>
								<Instruction>
									<xhtml-subset><big><big><big>If testing LLAs press <b>CONTINUE</b>, otherwise select <b>SKIP</b>
												</big>
											</big>
										</big>
									</xhtml-subset>
								</Instruction>
							</Manual>
						</Qualifier>
					</Qualifiers>
					<Step id="S11.ID_UVI264_BrdInst_ATP-832-34_22" title="LLA Inspection and Installation Guidelines" manual="true" duration="PT0H0M" OnFail="0" state="NotApplicable" lastupdated="12:00:00 AM" selected="true" elapsed="PT0H0M0S" runcount="0">
						<Prerequisites/>
						<Qualifiers/>
						<Task>
							<Manual><Instruction>
									<xhtml-subset>
										<ul>
											<li><big><big><big>Follow the instructions detailed in the LLA Inspection Process document link.</big>
													</big>
												</big>
											</li>
											<li><big><big><big>Write down each LLA part number, serial number, rev, and revision date. This information will be used in later steps.</big>
													</big>
												</big>
											</li>
											<li><big><big><big>Follow the instructions detailed in the MTF Installation Process document link.</big>
													</big>
												</big>
											</li>
											<li><big><big><big>Ensure each module test fixture has its corresponding fan cooling fixture correctly installed on the tester or TB6.</big>
													</big>
												</big>
											</li>
											<li><big><big><big>Select <b>CONTINUE</b> to proceed.
														</big>
													</big>
												</big>
											</li>
										</ul>
									</xhtml-subset>
								</Instruction><Link src="./UVI264_BrdInst_ATP-832-34/documents/LLA_Inspection_Process.doc">LLA Inspection Process</Link><Link src="./UVI264_BrdInst_ATP-832-34/documents/MTF_Installation_Process.doc">MTF Installation Process</Link>
							</Manual>
						</Task>
						<Diagnostics/>
						<Comment/>
					</Step><Step id="S12.ID_UVI264_BrdInst_ATP-832-34_27" title="Rev C LLA Inspection" manual="true" duration="PT0H0M" OnFail="0" state="NotApplicable" lastupdated="12:00:00 AM" selected="true" elapsed="PT0H0M0S" runcount="0">
						<Prerequisites/>
						<Qualifiers/>
						<Task>
							<Manual>
								<Instruction>
									<xhtml-subset><big><big><big>If testing rev. C modules, please follow the ECN074010 manual measurement instructions to verify ECN implementation. Skip this step if testing non-rev. C modules.</big>
											</big>
										</big>
									</xhtml-subset>
								</Instruction>
								<Link src="./UVI264_BrdInst_ATP-832-34/documents/ECN074010_Manual_Measurement.pdf">ECN074010 Manual Measurement Instructions</Link>
							</Manual>
						</Task>
						<Diagnostics/>
						<Comment/>
					</Step>
				</Flow>
				<Flow id="F13.ID_UVI264_BrdInst_ATP-832-34_5" title="HLA Inspection and Installation" OnFail="0" state="Pass" lastupdated="12/12/2025 7:34:04 AM" selected="false" procedure="UVI264_BrdInst_ATP-832-34" branch="false">
					<Prerequisites/>
					<Qualifiers><Qualifier>
							<Command Visible="true">
								<Instructions/>
								<Path>perl -e "if (index("%PEV_ProcExMode83234%", 'HlaInstall') != -1) {exit 0}else{exit 120}</Path>
							</Command>
						</Qualifier><Qualifier>
							<Manual>
								<Instruction>
									<xhtml-subset><big><big><big>If testing HLAs press <b>CONTINUE</b>, otherwise select <b>SKIP</b>
												</big>
											</big>
										</big>
									</xhtml-subset>
								</Instruction>
							</Manual>
						</Qualifier>
					</Qualifiers>
					<Step id="S14.ID_UVI264_BrdInst_ATP-832-34_97" title="HLA Inspection and Installation Guidelines" manual="true" duration="PT0H0M" OnFail="0" state="Pass" lastupdated="12/12/2025 7:34:04 AM" selected="false" elapsed="PT0H0M0S" runcount="1">
						<Prerequisites/>
						<Qualifiers/>
						<Task>
							<Manual><Instruction>
									<xhtml-subset><ul>
											<li><big><big><big>Follow the instructions detailed in the HLA Inspection Process document link.</big>
													</big>
												</big>
											</li>
											<li><big><big><big>Write down each HLA part number, serial number, rev, and revision date. Also, for each DISA-COMM, power board, and midplane adapter, write down the part number, serial number, rev, and revision date. This information will be used in later steps.</big>
													</big>
												</big>
											</li>
											<li><big><big><big>Follow the instructions detained in the HLA Installation Process document link.</big>
													</big>
												</big>
											</li>
											<li><big><big><big>Select <b>CONTINUE</b> to proceed.
														</big>
													</big>
												</big>
											</li>
										</ul>
									</xhtml-subset>
								</Instruction><Link src="./UVI264_BrdInst_ATP-832-34/documents/HLA_Inspection_Process.doc">HLA Inspection Process</Link><Link src="./UVI264_BrdInst_ATP-832-34/documents/HLA_Installation_Process.doc">HLA Installation Process</Link>
							</Manual>
						</Task>
						<Diagnostics/>
						<Comment/>
					</Step>
				</Flow><Flow id="F15.ID_UVI264_BrdInst_ATP-832-34_126" title="SMC Programming" OnFail="0" state="Initial" lastupdated="12:00:00 AM" selected="false" procedure="UVI264_BrdInst_ATP-832-34" branch="false">
					<Prerequisites/>
					<Qualifiers><Qualifier>
							<Command Visible="true">
								<Instructions/>
								<Path>perl -e "if (index("%PEV_ProcExMode83234%", 'SmcProgram') != -1) {exit 0}else{exit 120}</Path>
							</Command>
						</Qualifier><Qualifier>
							<Manual>
								<Instruction>
									<xhtml-subset><big><big><big>If programming the SMC press <b>CONTINUE</b>, otherwise select <b>SKIP</b>
												</big>
											</big>
										</big>
									</xhtml-subset>
								</Instruction>
								<Instruction>
									<xhtml-subset><big><big><big>Note: for pre-production MTF programming, follow the SMC table programming instructions located here:
<br/>
													<br/>
\\asp\repository\DC\Raiden\NPI\Pilot Line\DISA COMM Board
<br/>
													<br/>
Once complete, select <b>SKIP</b>
												</big>
											</big>
										</big>
									</xhtml-subset>
								</Instruction>
							</Manual>
						</Qualifier>
					</Qualifiers>
					<Flow id="F16.ID_UVI264_BrdInst_ATP-832-34_8" title="Program SMC" OnFail="0" state="Initial" lastupdated="12:00:00 AM" selected="false" procedure="UVI264_BrdInst_ATP-832-34" branch="false">
						<Prerequisites/>
						<Qualifiers/>
						<Step id="S17.ID_UVI264_BrdInst_ATP-832-34_4" title="Turn Off 48V" manual="true" duration="PT0H0M" OnFail="0" state="Initial" lastupdated="12:00:00 AM" selected="false" elapsed="PT0H0M0S" runcount="0">
							<Prerequisites/>
							<Qualifiers/>
							<Task>
								<Manual>
									<Instruction>
										<xhtml-subset><ul>
												<li><big><big><big>Ensure tester power (48V) is <b style="color:RED">OFF</b>
															</big>
														</big>
													</big>
												</li>
												<li><big><big><big>Select <b>CONTINUE</b> to proceed.
															</big>
														</big>
													</big>
												</li>
											</ul>
										</xhtml-subset>
									</Instruction>
								</Manual>
							</Task>
							<Diagnostics/>
							<Comment/>
						</Step><Step id="S18.ID_UVI264_BrdInst_ATP-832-34_23" title="Execute SMC Programming" manual="true" duration="PT0H0M" OnFail="0" state="Initial" lastupdated="12:00:00 AM" selected="false" elapsed="PT0H0M0S" runcount="0">
							<Prerequisites/>
							<Qualifiers/>
							<Task>
								<Command Visible="true">
									<Instructions><Instruction>
											<xhtml-subset><ul>
													<li><big><big><big>This step will launch SMC Updater which is used to program/update the SMC nodes of each HLA/MTF under test.</big>
															</big>
														</big>
													</li>
													<li><big><big><big>Select the slot number for the UVI264 under test. Then select update. The update process will take a few minutes.</big>
															</big>
														</big>
													</li>
													<li><big><big><big>Repeat this for each UVI264 slot.</big>
															</big>
														</big>
													</li>
													<li><big><big><big>Close SMC Updater when finished.</big>
															</big>
														</big>
													</li>
												</ul>
											</xhtml-subset>
										</Instruction>
									</Instructions>
									<Path>%IGXLROOT%\bin\SmcUpdater.exe</Path>
								</Command>
							</Task>
							<Diagnostics/>
							<Comment/>
						</Step><Step id="S19.ID_UVI264_BrdInst_ATP-832-34_87" title="Turn On 48V" manual="true" duration="PT0H0M" OnFail="0" state="Initial" lastupdated="12:00:00 AM" selected="false" elapsed="PT0H0M0S" runcount="0">
							<Prerequisites/>
							<Qualifiers/>
							<Task>
								<Manual>
									<Instruction>
										<xhtml-subset><ul>
												<li><big><big><big>Turn on system test power (48V)</big>
														</big>
													</big>
												</li>
												<li><big><big><big>Verify that the TB6/system stays on and does not shut down due to an SMC fault.</big>
														</big>
													</big>
												</li>
												<li><big><big><big>Wait until TRDS finishes mapping. Note: TRDS may not be able to map the UVI264 as the NVRAM has not been programmed yet.</big>
														</big>
													</big>
												</li>
												<li><big><big><big>If the TB6/system shuts down, select <b>FAIL</b> and review the tester status log for details. Otherwise, select <b>CONTINUE</b>.
															</big>
														</big>
													</big>
												</li>
											</ul>
										</xhtml-subset>
									</Instruction>
								</Manual>
							</Task>
							<Diagnostics><Diagnostic>
									<Command Visible="true">
										<Instructions/>
										<Path>"%Procedures%shared\scripts\UFII_Common_SetTPMVar.exe" TstFail TRUE</Path>
									</Command>
								</Diagnostic><Diagnostic>
									<Command Visible="true">
										<Instructions><Instruction>
												<xhtml-subset><ul>
														<li><big><big><big>This step will launch Maintenance which can be used to check fault conditions with system test power off.</big>
																</big>
															</big>
														</li>
														<li><big><big><big>Select the SMC tab and look for lines shown in <b style="color:RED">RED</b>.
																	</big>
																</big>
															</big>
														</li>
														<li><big><big><big>Launch MobaXTerm Personal Edison and type <b>telnet 10.0.0.2</b> and hit enter.
																	</big>
																</big>
															</big>
														</li>
														<li><big><big><big>Type <b>nodes</b> and hit enter
																	</big>
																</big>
															</big>
														</li>
														<li><big><big><big>Verify that the SMC firmware and limit table programmed in the previous step is listed under the UVI264.</big>
																</big>
															</big>
														</li>
													</ul>
												</xhtml-subset>
											</Instruction>
										</Instructions>
										<Path>%IGXLROOT%\bin\Maintenance.exe</Path>
									</Command>
								</Diagnostic>
							</Diagnostics>
							<Comment/>
						</Step>
					</Flow>
				</Flow><Flow id="F20.ID_UVI264_BrdInst_ATP-832-34_123" title="NVRAM Programming" OnFail="0" state="Initial" lastupdated="12:00:00 AM" selected="false" procedure="UVI264_BrdInst_ATP-832-34" branch="false">
					<Prerequisites/>
					<Qualifiers><Qualifier>
							<Command Visible="true">
								<Instructions/>
								<Path>perl -e "if (index("%PEV_ProcExMode83234%", 'NvramProgram') != -1) {exit 0}else{exit 120}</Path>
							</Command>
						</Qualifier><Qualifier>
							<Manual>
								<Instruction>
									<xhtml-subset><big><big><big>If programming the NVRAM press <b>CONTINUE</b>, otherwise select <b>SKIP</b>
												</big>
											</big>
										</big>
									</xhtml-subset>
								</Instruction>
							</Manual>
						</Qualifier>
					</Qualifiers>
					<Step id="S21.ID_UVI264_BrdInst_ATP-832-34_37" title="Turn On 48V" manual="true" duration="PT0H0M" OnFail="0" state="Initial" lastupdated="12:00:00 AM" selected="false" elapsed="PT0H0M0S" runcount="0">
						<Prerequisites/>
						<Qualifiers/>
						<Task>
							<Manual>
								<Instruction>
									<xhtml-subset><ul>
											<li><big><big><big>Turn on system test power (48V)</big>
													</big>
												</big>
											</li>
											<li><big><big><big>Wait until TRDS finishes mapping.</big>
													</big>
												</big>
											</li>
											<li><big><big><big>If TRDS fails to map due to an unrecognized HLA (new HLA), <b>wait five minutes</b> for the FPGA programming to complete.
														</big>
													</big>
												</big>
											</li>
											<li><big><big><big>Select <b>remap</b> in TRDS and wait until TRDS finishes mapping. Note: TRDS may not be able to map the UVI264 as the NVRAM has not been programmed yet.
														</big>
													</big>
												</big>
											</li>
											<li><big><big><big>Select <b>CONTINUE</b> to proceed.
														</big>
													</big>
												</big>
											</li>
										</ul>
									</xhtml-subset>
								</Instruction>
							</Manual>
						</Task>
						<Diagnostics/>
						<Comment/>
					</Step><Step id="S22.ID_UVI264_BrdInst_ATP-832-34_6" title="Enter Board Information" manual="true" duration="PT0H0M" OnFail="0" state="Initial" lastupdated="12:00:00 AM" selected="false" elapsed="PT0H0M0S" runcount="0">
