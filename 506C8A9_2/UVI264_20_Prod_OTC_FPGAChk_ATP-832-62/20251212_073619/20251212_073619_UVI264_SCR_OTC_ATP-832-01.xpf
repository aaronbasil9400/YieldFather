					<Step id="S37.ID_UVI264_FPGAProg_ATP-832-62_1" title="Update FPGAs" manual="true" duration="PT0H0M" OnFail="0" state="Initial" lastupdated="12:00:00 AM" selected="true" elapsed="PT0H0M0S" runcount="0">
